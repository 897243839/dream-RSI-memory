{
    "name": "dream-rsi-memory",
    "version": "2.3.0",
    "type": "module",
    "description": "Self-evolving long-term memory plugin for opencode — independent TypeScript implementation of the Dream-RSI technique (arXiv:2609.14858).",
    "main": "./dist/index.js",
    "bin": {
        "dreamrsimem": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js"
        },
        "./server": {
            "import": "./dist/index.js"
        }
    },
    "files": [
        "index.js",
        "dist",
        "scripts"
    ],
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "build": "npm run clean && tsc",
        "typecheck": "tsc --noEmit",
        "test": "npm run build && node --test \"test/*.test.mjs\"",
        "install:opencode": "node scripts/install.mjs",
        "cli": "node dist/cli.js",
        "install:opencode:offline": "node scripts/install.mjs --offline",
        "vendor": "node scripts/install.mjs --vendor",
        "pack:offline": "node scripts/install.mjs --offline-package",
        "uninstall:opencode": "node scripts/install.mjs --uninstall",
        "prepublishOnly": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/897243839/dream-RSI-memory.git"
    },
    "homepage": "https://github.com/897243839/dream-RSI-memory",
    "bugs": {
        "url": "https://github.com/897243839/dream-RSI-memory/issues"
    },
    "keywords": [
        "opencode",
        "opencode-plugin",
        "plugin",
        "memory",
        "long-term-memory",
        "ai-memory",
        "agent-memory",
        "ai-agent",
        "llm",
        "ai",
        "typescript",
        "dream-rsi",
        "recall"
    ],
    "license": "AGPL-3.0-or-later",
    "peerDependencies": {
        "@opencode-ai/plugin": ">=1.4.3"
    },
    "devDependencies": {
        "@opencode-ai/plugin": "^1.4.3",
        "@types/node": "^25.5.0",
        "typescript": "^6.0.2"
    }
}
